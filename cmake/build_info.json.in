{
  "project_name": "@PROJECT_NAME@",
  "project_version": "@PROJECT_VERSION@",
  "profile": "@PEREGRINE_PROFILE_LOWER@",
  "build_type": "@CMAKE_BUILD_TYPE@",
  "generator": "@CMAKE_GENERATOR@",
  "system_name": "@CMAKE_SYSTEM_NAME@",
  "system_processor": "@CMAKE_SYSTEM_PROCESSOR@",
  "c_compiler_id": "@CMAKE_C_COMPILER_ID@",
  "c_compiler_version": "@CMAKE_C_COMPILER_VERSION@",
  "cxx_compiler_id": "@CMAKE_CXX_COMPILER_ID@",
  "cxx_compiler_version": "@CMAKE_CXX_COMPILER_VERSION@",
  "c_flags": "@CMAKE_C_FLAGS@",
  "c_flags_debug": "@CMAKE_C_FLAGS_DEBUG@",
  "c_flags_release": "@CMAKE_C_FLAGS_RELEASE@",
  "cxx_flags": "@CMAKE_CXX_FLAGS@",
  "cxx_flags_debug": "@CMAKE_CXX_FLAGS_DEBUG@",
  "cxx_flags_release": "@CMAKE_CXX_FLAGS_RELEASE@",
  "profiling_enabled": "@PEREGRINE_ENABLE_PROFILING@",
  "native_tuning_enabled": "@PEREGRINE_ENABLE_NATIVE_TUNING@",
  "lto_enabled": "@PEREGRINE_ENABLE_LTO@",
  "coverage_enabled": "@PEREGRINE_GENERATE_COVERAGE@",
  "thread_pinning_enabled": "@PEREGRINE_USE_THREAD_PINNING@",
  "hdrhistogram_enabled": "@PEREGRINE_ENABLE_HDRHISTOGRAM@",
  "af_xdp_requested": "@PEREGRINE_AF_XDP@",
  "af_xdp_available": "@PEREGRINE_AF_XDP_AVAILABLE@",
  "network_backend_afxdp": "@PEREGRINE_NETWORK_BACKEND_AFXDP@",
  "network_backend_syscall": "@PEREGRINE_NETWORK_BACKEND_SYSCALL@",
  "iperf3_enabled": "@PEREGRINE_IPERF3@",
  "build_tests": "@PEREGRINE_BUILD_TESTS@",
  "build_benchmarks": "@PEREGRINE_BUILD_BENCHMARKS@",
  "core_ingest": "@PEREGRINE_CORE_INGEST@",
  "core_decode": "@PEREGRINE_CORE_DECODE@",
  "core_match": "@PEREGRINE_CORE_MATCH@",
  "core_logger": "@PEREGRINE_CORE_LOGGER@",
  "core_nack": "@PEREGRINE_CORE_NACK@",
  "git_commit": "@PEREGRINE_GIT_COMMIT@"
}
